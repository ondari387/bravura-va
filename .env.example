# ---- Bravura VA environment configuration ----
# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bravura.co.ke

# Calendly booking link. Leave empty until the real link is available -
# the site shows a contact/WhatsApp fallback while this is blank.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/va-bravura/30min

# ---- Supabase (stores every enquiry and newsletter sign-up) ----
# Supabase > Project Settings > API (or Data API). Use the SECRET service_role key, never the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (emails you each new enquiry) ----
RESEND_API_KEY=
# Must use a domain you've verified in Resend, e.g. Bravura VA <notifications@bravura.co.ke>
RESEND_FROM=
# Who receives new-enquiry emails (comma-separated for several)
NOTIFY_EMAIL=va@bravura.co.ke
# Set to true to also send the visitor a short "thanks, we got your message" email
SEND_AUTOREPLY=false

# Optional: also forward submissions to a webhook (Zapier, Make, CRM...)
# Where form submissions are delivered (contact, quote, service enquiry).
# Any HTTPS endpoint that accepts JSON POSTs: Zapier/Make webhook, Formspree, your CRM, etc.
FORM_WEBHOOK_URL=
# Where newsletter sign-ups are delivered (e.g. Mailchimp/Brevo/ConvertKit webhook)
NEWSLETTER_WEBHOOK_URL=

# Optional analytics (loaded only after the visitor accepts analytics cookies)
NEXT_PUBLIC_GA_ID=
