# ---- Bravura VA environment configuration ----
# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bravura.co.ke

# Calendly booking link. Leave empty until the real link is available —
# the site shows a contact/WhatsApp fallback while this is blank.
NEXT_PUBLIC_CALENDLY_URL=

# Where form submissions are delivered (contact, quote, service enquiry).
# Any HTTPS endpoint that accepts JSON POSTs: Zapier/Make webhook, Formspree, your CRM, etc.
FORM_WEBHOOK_URL=
# Where newsletter sign-ups are delivered (e.g. Mailchimp/Brevo/ConvertKit webhook)
NEWSLETTER_WEBHOOK_URL=

# Optional analytics (loaded only after the visitor accepts analytics cookies)
NEXT_PUBLIC_GA_ID=
